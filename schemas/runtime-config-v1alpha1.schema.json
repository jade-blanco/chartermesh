{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chartermesh:schema:runtime-config:v1alpha1",
  "title": "CharterMesh runtime configuration v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "modelEngines", "managedRunners"],
  "properties": {
    "apiVersion": {
      "const": "chartermesh.dev/runtime/v1alpha1"
    },
    "modelEngines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "adapter"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "adapter": { "const": "fake" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "adapter", "endpoint", "model"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "adapter": { "const": "openai-compatible" },
              "endpoint": { "type": "string", "format": "uri" },
              "model": { "type": "string", "minLength": 1 },
              "apiKeyEnv": { "type": "string", "minLength": 1 },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 600000
              }
            }
          }
        ]
      }
    },
    "managedRunners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "adapter", "modelEngineRef"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "adapter": { "const": "builtin-managed-runner" },
          "modelEngineRef": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
