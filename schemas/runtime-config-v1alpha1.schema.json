{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chartermesh:schema:runtime-config:v1alpha1",
  "title": "CharterMesh runtime configuration v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "modelEngines", "managedRunners"],
  "properties": {
    "apiVersion": {
      "const": "chartermesh.dev/runtime/v1alpha1"
    },
    "modelEngines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "adapter"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "adapter": { "const": "fake" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "adapter", "endpoint", "model"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "adapter": { "const": "openai-compatible" },
              "endpoint": { "type": "string", "format": "uri" },
              "model": { "type": "string", "minLength": 1 },
              "apiKeyEnv": { "type": "string", "minLength": 1 },
              "structuredOutputMode": {
                "enum": ["prompt", "json-schema"]
              },
              "toolCalling": { "type": "boolean" },
              "reasoningMode": {
                "enum": ["default", "disabled"]
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 600000
              },
              "maxResponseBytes": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 67108864
              },
              "pricing": {
                "$ref": "#/$defs/pricing"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "adapter",
              "command",
              "executableSha256"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "adapter": { "const": "command-process" },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "executableSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "args": {
                "type": "array",
                "items": { "type": "string" }
              },
              "model": { "type": "string", "minLength": 1 },
              "environmentAllowlist": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 600000
              },
              "pricing": {
                "$ref": "#/$defs/pricing"
              }
            }
          }
        ]
      }
    },
    "managedRunners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "adapter", "modelEngineRef"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "adapter": { "const": "builtin-managed-runner" },
          "modelEngineRef": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputPerMillionTokensUsd",
        "outputPerMillionTokensUsd"
      ],
      "properties": {
        "inputPerMillionTokensUsd": {
          "type": "number",
          "minimum": 0
        },
        "outputPerMillionTokensUsd": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
