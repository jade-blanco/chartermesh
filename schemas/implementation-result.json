{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chartermesh:schema:implementation-result:v1alpha1",
  "title": "Implementation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "artifacts",
    "verification"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
