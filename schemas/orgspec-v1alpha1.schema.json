{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chartermesh:schema:orgspec:v1alpha1",
  "title": "CharterMesh OrgSpec v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "chartermesh.dev/v1alpha1"
    },
    "kind": {
      "const": "Organization"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monthlyCostLimitUsd",
        "maxConcurrentRuns",
        "maxDailyModelStarts"
      ],
      "properties": {
        "monthlyCostLimitUsd": {
          "type": "number",
          "minimum": 0
        },
        "maxConcurrentRuns": {
          "type": "integer",
          "minimum": 1
        },
        "maxDailyModelStarts": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "modelEngine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapter",
        "transport",
        "enabled"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": [
            "http",
            "local_process",
            "embedded"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "agentHost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapter",
        "executionHost",
        "enabled"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "executionHost": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "managedRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapter",
        "modelEngineRef",
        "executionHost",
        "enabled"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "modelEngineRef": {
          "$ref": "#/$defs/id"
        },
        "executionHost": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "executionTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "runnerRef",
            "enabled"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "managed_runner"
            },
            "runnerRef": {
              "$ref": "#/$defs/id"
            },
            "enabled": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "hostRef",
            "enabled"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "agent_host"
            },
            "hostRef": {
              "$ref": "#/$defs/id"
            },
            "enabled": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "executionSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred"
      ],
      "properties": {
        "preferred": {
          "$ref": "#/$defs/id"
        },
        "fallbacks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "allowEmulation": {
          "type": "boolean"
        }
      }
    },
    "toolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow"
      ],
      "properties": {
        "allow": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approvalRequired": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "maxWorkers",
        "workspaceIsolation",
        "communication",
        "humanApprovalAuthority"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "single",
            "delegated",
            "peer_team"
          ]
        },
        "maxWorkers": {
          "type": "integer",
          "minimum": 1
        },
        "workspaceIsolation": {
          "enum": [
            "required",
            "preferred",
            "shared_read_only"
          ]
        },
        "communication": {
          "enum": [
            "parent_only",
            "peer_messages"
          ]
        },
        "humanApprovalAuthority": {
          "const": "control_plane_only"
        },
        "allowExperimental": {
          "type": "boolean"
        },
        "fileOwnership": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "single"
              }
            }
          },
          "then": {
            "properties": {
              "maxWorkers": {
                "const": 1
              },
              "communication": {
                "const": "parent_only"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "communication": {
                "const": "peer_messages"
              }
            }
          },
          "then": {
            "properties": {
              "strategy": {
                "const": "peer_team"
              }
            }
          }
        }
      ]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "class",
        "executionMode",
        "capabilities",
        "execution",
        "tools"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "enum": [
            "c_level",
            "worker",
            "reviewer",
            "deterministic"
          ]
        },
        "executionMode": {
          "enum": [
            "manual_persistent",
            "on_demand_ephemeral",
            "scheduled_ephemeral"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredRuntimeCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredModelCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "promptRef": {
          "type": "string",
          "minLength": 1
        },
        "execution": {
          "$ref": "#/$defs/executionSelection"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "tools": {
          "$ref": "#/$defs/toolPolicy"
        },
        "orchestration": {
          "$ref": "#/$defs/orchestration"
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "agent",
            "approval",
            "deterministic"
          ],
          "default": "agent"
        },
        "role": {
          "$ref": "#/$defs/id"
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "outputContract": {
          "type": "string",
          "minLength": 1
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "externalSideEffect": {
          "type": "boolean"
        },
        "executionApprovalRequired": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "agent"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "role"
            ],
            "anyOf": [
              {
                "required": [
                  "outputContract"
                ]
              },
              {
                "required": [
                  "acceptanceCriteria"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "externalSideEffect": {
                "const": true
              }
            },
            "required": [
              "externalSideEffect"
            ]
          },
          "then": {
            "properties": {
              "executionApprovalRequired": {
                "const": true
              }
            },
            "required": [
              "executionApprovalRequired"
            ]
          }
        }
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "trigger",
        "stages"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "queue",
                "manual",
                "schedule"
              ]
            }
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stage"
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workflow",
        "cadence",
        "activation",
        "noWorkBehavior",
        "overlapPolicy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "workflow": {
          "$ref": "#/$defs/id"
        },
        "cadence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rrule",
            "timezone"
          ],
          "properties": {
            "rrule": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "activation": {
          "enum": [
            "proposed",
            "active",
            "paused"
          ]
        },
        "executor": {
          "enum": [
            "controller",
            "provider_native"
          ],
          "default": "controller"
        },
        "executionTarget": {
          "$ref": "#/$defs/id"
        },
        "nativeSurface": {
          "enum": [
            "local",
            "hosted",
            "chat_continuation"
          ]
        },
        "noWorkBehavior": {
          "enum": [
            "skip_without_model",
            "start_and_check"
          ]
        },
        "overlapPolicy": {
          "enum": [
            "forbid",
            "allow"
          ]
        },
        "degradedAcknowledged": {
          "type": "boolean"
        },
        "emptyStartAccounting": {
          "type": "boolean"
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalSideEffects",
        "destructiveActions",
        "providerFailover",
        "organizationChanges",
        "firstRunMode"
      ],
      "properties": {
        "externalSideEffects": {
          "enum": [
            "user_approval",
            "prohibited"
          ]
        },
        "destructiveActions": {
          "enum": [
            "user_approval",
            "prohibited"
          ]
        },
        "providerFailover": {
          "const": "same_or_lower_permissions"
        },
        "organizationChanges": {
          "const": "user_approval"
        },
        "firstRunMode": {
          "const": "read_only"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission",
        "operatingProfile",
        "budgets",
        "modelEngines",
        "agentHosts",
        "managedRunners",
        "executionTargets",
        "roles",
        "workflows",
        "schedules",
        "policies"
      ],
      "properties": {
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "operatingProfile": {
          "enum": [
            "lean",
            "balanced",
            "controlled"
          ]
        },
        "budgets": {
          "$ref": "#/$defs/budgets"
        },
        "modelEngines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/modelEngine"
          }
        },
        "agentHosts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agentHost"
          }
        },
        "managedRunners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/managedRunner"
          }
        },
        "executionTargets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/executionTarget"
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workflow"
          }
        },
        "schedules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schedule"
          }
        },
        "policies": {
          "$ref": "#/$defs/policies"
        }
      }
    }
  }
}
